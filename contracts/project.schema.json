{
  "$defs": {
    "ChannelDisplay": {
      "description": "Channel display (amplitude) settings (M1.15 \u00a717.5).\n\n``scales`` are per-channel display amplitudes (editor range\n0.25-16); at most one entry per source channel.",
      "properties": {
        "linked": {
          "default": true,
          "title": "Linked",
          "type": "boolean"
        },
        "scales": {
          "items": {
            "type": "number"
          },
          "maxItems": 8,
          "title": "Scales",
          "type": "array"
        }
      },
      "title": "ChannelDisplay",
      "type": "object"
    },
    "CountInMode": {
      "description": "Count-in length (milestone3.md \u00a717.1).",
      "enum": [
        "off",
        "one_bar",
        "two_bars"
      ],
      "title": "CountInMode",
      "type": "string"
    },
    "CountInRepetition": {
      "description": "Whether count-in repeats with every loop pass (milestone3.md \u00a717.9).",
      "enum": [
        "once",
        "every_repeat"
      ],
      "title": "CountInRepetition",
      "type": "string"
    },
    "CountInSettings": {
      "description": "Count-in preferences; transport behavior is implemented in M3.15.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CountInMode",
          "default": "off"
        },
        "repetition": {
          "$ref": "#/$defs/CountInRepetition",
          "default": "once"
        }
      },
      "title": "CountInSettings",
      "type": "object"
    },
    "LoopAnchorMode": {
      "description": "Authoritative coordinate pair for a practice loop (M3.13).",
      "enum": [
        "source",
        "musical"
      ],
      "title": "LoopAnchorMode",
      "type": "string"
    },
    "MarkerRecord": {
      "description": "A single marker annotation in a project (\u00a717.1).",
      "properties": {
        "color": {
          "description": "Hex color #rrggbb",
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "created_at": {
          "description": "UTC timestamp in ISO 8601 form",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "position_frames": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Position Frames",
          "type": "integer"
        },
        "project_id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "updated_at": {
          "description": "UTC timestamp in ISO 8601 form",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "position_frames",
        "label",
        "color",
        "created_at",
        "updated_at"
      ],
      "title": "MarkerRecord",
      "type": "object"
    },
    "MetronomeSettings": {
      "description": "Metronome preferences; audio behavior is implemented in M3.14.",
      "properties": {
        "accent_downbeats": {
          "default": true,
          "title": "Accent Downbeats",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "subdivision": {
          "$ref": "#/$defs/MetronomeSubdivision",
          "default": "primary"
        },
        "volume": {
          "default": 0.5,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Volume",
          "type": "number"
        }
      },
      "title": "MetronomeSettings",
      "type": "object"
    },
    "MetronomeSubdivision": {
      "description": "Metronome subdivision modes (milestone3.md \u00a716.6).",
      "enum": [
        "primary",
        "denominator",
        "half_beat",
        "quarter_beat"
      ],
      "title": "MetronomeSubdivision",
      "type": "string"
    },
    "MusicalPosition": {
      "description": "Exact reduced rational musical position in quarter-note units.\n\nThe denominator is always positive; the sign lives on the numerator.\nZero is always ``0/1``. Normalized components stay within the\nJavaScript safe-integer range so the browser never receives a value\nit cannot represent exactly.",
      "properties": {
        "denominator": {
          "description": "Positive denominator",
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "description": "Signed quarter-note numerator",
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "MusicalPosition",
      "type": "object"
    },
    "PlaybackMode": {
      "description": "Which source the transport plays (spec \u00a73.5).",
      "enum": [
        "original",
        "bass_pair",
        "four_stems"
      ],
      "title": "PlaybackMode",
      "type": "string"
    },
    "PracticeLoop": {
      "description": "A saved practice loop with integer source-frame boundaries (spec \u00a713.1).\n\n``repeat_count`` is the total number of passes (not \"extra repeats\");\n``None`` means infinite. ``boundary_fade`` enables the short output\nfades at the join (\u00a713.6); disabling them gives exact boundary\naudition. The boundaries are exact source frames and are never\nexpanded (\u00a713.3.5\u20136).",
      "properties": {
        "anchor_mode": {
          "$ref": "#/$defs/LoopAnchorMode",
          "default": "source"
        },
        "boundary_fade": {
          "default": true,
          "title": "Boundary Fade",
          "type": "boolean"
        },
        "color": {
          "default": "#f59e0b",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "created_at": {
          "description": "UTC timestamp in ISO 8601 form",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "end_frames": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End Frames",
          "type": "integer"
        },
        "end_musical": {
          "anyOf": [
            {
              "$ref": "#/$defs/MusicalPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grid_branch_id": {
          "anyOf": [
            {
              "description": "UUID identifier, serialized as a string",
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid Branch Id"
        },
        "grid_branch_revision": {
          "anyOf": [
            {
              "description": "Nonnegative integer revision",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid Branch Revision"
        },
        "id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repeat_count": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Count"
        },
        "resolved_source_end": {
          "anyOf": [
            {
              "description": "Integer source sample position (never milliseconds)",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Source End"
        },
        "resolved_source_start": {
          "anyOf": [
            {
              "description": "Integer source sample position (never milliseconds)",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Source Start"
        },
        "start_frames": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Frames",
          "type": "integer"
        },
        "start_musical": {
          "anyOf": [
            {
              "$ref": "#/$defs/MusicalPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unresolved": {
          "default": false,
          "title": "Unresolved",
          "type": "boolean"
        },
        "updated_at": {
          "description": "UTC timestamp in ISO 8601 form",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "start_frames",
        "end_frames",
        "created_at",
        "updated_at"
      ],
      "title": "PracticeLoop",
      "type": "object"
    },
    "PracticeState": {
      "description": "Per-project mixer and practice state (spec \u00a73.5).\n\n``tracks`` is keyed by stem role value (``StemRole``). Stem playback\nmodes require an active result set; ``original`` plays the source mix\nand may still remember the last result set.",
      "properties": {
        "active_loop_id": {
          "anyOf": [
            {
              "description": "UUID identifier, serialized as a string",
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Loop Id"
        },
        "active_result_set_id": {
          "anyOf": [
            {
              "description": "UUID identifier, serialized as a string",
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Result Set Id"
        },
        "loop_enabled": {
          "default": false,
          "title": "Loop Enabled",
          "type": "boolean"
        },
        "loops": {
          "items": {
            "$ref": "#/$defs/PracticeLoop"
          },
          "title": "Loops",
          "type": "array"
        },
        "master_gain": {
          "default": 1.0,
          "maximum": 3.9810717055349722,
          "minimum": 0.0,
          "title": "Master Gain",
          "type": "number"
        },
        "monitoring_limiter": {
          "default": true,
          "title": "Monitoring Limiter",
          "type": "boolean"
        },
        "playback_mode": {
          "$ref": "#/$defs/PlaybackMode",
          "default": "original"
        },
        "playback_speed": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.25,
          "title": "Playback Speed",
          "type": "number"
        },
        "tracks": {
          "additionalProperties": {
            "$ref": "#/$defs/TrackSettings"
          },
          "maxProperties": 8,
          "title": "Tracks",
          "type": "object"
        }
      },
      "title": "PracticeState",
      "type": "object"
    },
    "ProjectRhythmState": {
      "description": "Project-level rhythm display and practice settings (\u00a73.10).",
      "properties": {
        "active_automatic_result_id": {
          "anyOf": [
            {
              "description": "UUID identifier, serialized as a string",
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Automatic Result Id"
        },
        "active_branch_id": {
          "anyOf": [
            {
              "description": "UUID identifier, serialized as a string",
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Branch Id"
        },
        "count_in": {
          "$ref": "#/$defs/CountInSettings"
        },
        "display_mode": {
          "$ref": "#/$defs/RhythmDisplayMode",
          "default": "automatic"
        },
        "lane_height": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.25,
          "title": "Lane Height",
          "type": "number"
        },
        "lane_visible": {
          "default": true,
          "title": "Lane Visible",
          "type": "boolean"
        },
        "last_selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectedRhythmObject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metronome": {
          "$ref": "#/$defs/MetronomeSettings"
        },
        "ruler_visible": {
          "default": true,
          "title": "Ruler Visible",
          "type": "boolean"
        },
        "snap_mode": {
          "$ref": "#/$defs/SnapMode",
          "default": "beat"
        }
      },
      "title": "ProjectRhythmState",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "empty",
        "ready"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RhythmDisplayMode": {
      "description": "Whether the project shows the automatic result or an edited branch.",
      "enum": [
        "automatic",
        "edited"
      ],
      "title": "RhythmDisplayMode",
      "type": "string"
    },
    "SelectedRhythmObject": {
      "description": "The last selected rhythm object, for editor restoration.",
      "properties": {
        "id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SelectedRhythmObjectKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "SelectedRhythmObject",
      "type": "object"
    },
    "SelectedRhythmObjectKind": {
      "description": "Kinds that can be the project's last selected rhythm object.",
      "enum": [
        "pulse",
        "tempo_anchor",
        "meter_region"
      ],
      "title": "SelectedRhythmObjectKind",
      "type": "string"
    },
    "SelectionRange": {
      "description": "A frame selection ``[start, end)`` in source frames (M1.15 \u00a717.5).",
      "properties": {
        "end": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SelectionRange",
      "type": "object"
    },
    "SnapMode": {
      "description": "Musical snapping modes (milestone3.md \u00a714.1).",
      "enum": [
        "off",
        "beat",
        "half_beat",
        "quarter_beat",
        "bar",
        "event"
      ],
      "title": "SnapMode",
      "type": "string"
    },
    "TrackSettings": {
      "description": "Mixer settings for one stem track (spec \u00a73.5).",
      "properties": {
        "balance": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Balance",
          "type": "number"
        },
        "color": {
          "default": "#8fa3bf",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "display_height": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.25,
          "title": "Display Height",
          "type": "number"
        },
        "gain": {
          "default": 1.0,
          "maximum": 3.9810717055349722,
          "minimum": 0.0,
          "title": "Gain",
          "type": "number"
        },
        "mute": {
          "default": false,
          "title": "Mute",
          "type": "boolean"
        },
        "solo": {
          "default": false,
          "title": "Solo",
          "type": "boolean"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "title": "TrackSettings",
      "type": "object"
    },
    "ViewportState": {
      "description": "A persisted editor viewport, width-free (M1.15 \u00a717.5).",
      "properties": {
        "frames_per_css_pixel": {
          "exclusiveMinimum": 0,
          "title": "Frames Per Css Pixel",
          "type": "number"
        },
        "start_frame": {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "frames_per_css_pixel"
      ],
      "title": "ViewportState",
      "type": "object"
    },
    "WaveformStatus": {
      "enum": [
        "none",
        "pending",
        "ready"
      ],
      "title": "WaveformStatus",
      "type": "string"
    },
    "WorkingState": {
      "description": "Per-project working state persisted by autosave (M1.15 \u00a717.5).\n\nFrame-valued fields are validated against the project's\n``duration_frames`` by ``ProjectRecord``.",
      "properties": {
        "channel_display": {
          "$ref": "#/$defs/ChannelDisplay"
        },
        "follow_playhead": {
          "default": true,
          "title": "Follow Playhead",
          "type": "boolean"
        },
        "last_position_frames": {
          "default": 0,
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Last Position Frames",
          "type": "integer"
        },
        "monitoring_volume": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Monitoring Volume",
          "type": "number"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewportState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "WorkingState",
      "type": "object"
    }
  },
  "$id": "https://basseparate.local/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A persisted working project.\n\nAn empty project has ``status == \"empty\"`` and all source fields\nnull. A ready project has the original-file asset, the canonical\nPCM asset, and complete source timing/channel metadata.",
  "project_schema_version": 5,
  "properties": {
    "can_redo": {
      "default": false,
      "title": "Can Redo",
      "type": "boolean"
    },
    "can_undo": {
      "default": false,
      "title": "Can Undo",
      "type": "boolean"
    },
    "canonical_asset_id": {
      "anyOf": [
        {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Asset Id"
    },
    "created_at": {
      "description": "UTC timestamp in ISO 8601 form",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decode_profile_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decode Profile Version"
    },
    "duration_frames": {
      "anyOf": [
        {
          "description": "Integer source sample position (never milliseconds)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Decoded frame count of the canonical audio (authoritative)",
      "title": "Duration Frames"
    },
    "id": {
      "description": "UUID identifier, serialized as a string",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/MarkerRecord"
      },
      "title": "Markers",
      "type": "array"
    },
    "monitoring_asset_id": {
      "anyOf": [
        {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monitoring Asset Id"
    },
    "monitoring_left_channel": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monitoring Left Channel"
    },
    "monitoring_right_channel": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monitoring Right Channel"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "practice_state": {
      "$ref": "#/$defs/PracticeState"
    },
    "revision": {
      "default": 0,
      "description": "Nonnegative integer revision",
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "rhythm_state": {
      "$ref": "#/$defs/ProjectRhythmState"
    },
    "sample_rate": {
      "anyOf": [
        {
          "description": "Sample rate in Hz",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Selected source stream sample rate in Hz",
      "title": "Sample Rate"
    },
    "schema_version": {
      "default": 5,
      "description": "Project schema version",
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_asset_id": {
      "anyOf": [
        {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Asset Id"
    },
    "source_channel_count": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Channel Count"
    },
    "source_channel_layout": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Channel Layout"
    },
    "source_metadata": {
