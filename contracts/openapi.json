{
  "components": {
    "schemas": {
      "AudioStreamInfo": {
        "description": "One audio stream reported by ffprobe (global stream index).",
        "properties": {
          "channel_count": {
            "minimum": 1.0,
            "title": "Channel Count",
            "type": "integer"
          },
          "channel_layout": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Layout"
          },
          "codec": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Codec",
            "type": "string"
          },
          "estimated_duration_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Duration Seconds"
          },
          "index": {
            "description": "Global stream index in the container",
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "language": {
            "anyOf": [
              {
                "maxLength": 8,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "sample_rate": {
            "minimum": 1.0,
            "title": "Sample Rate",
            "type": "integer"
          },
          "start_timestamp_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Timestamp Seconds"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "index",
          "codec",
          "sample_rate",
          "channel_count"
        ],
        "title": "AudioStreamInfo",
        "type": "object"
      },
      "CancelImportResponse": {
        "properties": {
          "import_id": {
            "format": "uuid",
            "title": "Import Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "import_id",
          "state"
        ],
        "title": "CancelImportResponse",
        "type": "object"
      },
      "ChunkAckResponse": {
        "properties": {
          "chunk_bytes": {
            "title": "Chunk Bytes",
            "type": "integer"
          },
          "idempotent_replay": {
            "default": false,
            "title": "Idempotent Replay",
            "type": "boolean"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "chunk_bytes"
        ],
        "title": "ChunkAckResponse",
        "type": "object"
      },
      "CompleteImportResponse": {
        "properties": {
          "import_id": {
            "format": "uuid",
            "title": "Import Id",
            "type": "string"
          },
          "probe_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProbeResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_stream_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Stream Index"
          },
          "source_sha256": {
            "title": "Source Sha256",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "import_id",
          "source_sha256",
          "state"
        ],
        "title": "CompleteImportResponse",
        "type": "object"
      },
      "CreateImportRequest": {
        "properties": {
          "declared_byte_count": {
            "minimum": 1.0,
            "title": "Declared Byte Count",
            "type": "integer"
          },
          "filename": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "filename",
          "declared_byte_count"
        ],
        "title": "CreateImportRequest",
        "type": "object"
      },
      "CreateImportResponse": {
        "properties": {
          "chunk_size": {
            "title": "Chunk Size",
            "type": "integer"
          },
          "import_id": {
            "format": "uuid",
            "title": "Import Id",
            "type": "string"
          },
          "max_import_bytes": {
            "title": "Max Import Bytes",
            "type": "integer"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "import_id",
          "project_id",
          "chunk_size",
          "max_import_bytes",
          "state"
        ],
        "title": "CreateImportResponse",
        "type": "object"
      },
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportListResponse": {
        "properties": {
          "imports": {
            "items": {
              "$ref": "#/components/schemas/ImportRecord"
            },
            "title": "Imports",
            "type": "array"
          }
        },
        "required": [
          "imports"
        ],
        "title": "ImportListResponse",
        "type": "object"
      },
      "ImportRecord": {
        "description": "One import session targeting a single project.",
        "properties": {
          "created_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Created At",
            "type": "string"
          },
          "declared_byte_count": {
            "minimum": 0.0,
            "title": "Declared Byte Count",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "filename": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "description": "UUID identifier, serialized as a string",
            "title": "Id",
            "type": "string"
          },
          "job_ids": {
            "default": [],
            "items": {
              "description": "UUID identifier, serialized as a string",
              "type": "string"
            },
            "title": "Job Ids",
            "type": "array"
          },
          "probe_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProbeResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_id": {
            "description": "UUID identifier, serialized as a string",
            "title": "Project Id",
            "type": "string"
          },
          "received_byte_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Received Byte Count",
            "type": "integer"
          },
          "selected_stream_index": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Stream Index"
          },
          "source_sha256": {
            "anyOf": [
              {
                "description": "SHA-256 hash, lowercase hexadecimal",
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Sha256"
          },
          "transfer_state": {
            "$ref": "#/components/schemas/TransferState",
            "default": "created"
          },
          "updated_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "filename",
          "declared_byte_count",
          "created_at",
          "updated_at"
        ],
        "title": "ImportRecord",
        "type": "object"
      },
      "ModelListResponse": {
        "properties": {
          "models": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "title": "ModelListResponse",
        "type": "object"
      },
      "ModuleListResponse": {
        "properties": {
          "modules": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Modules",
            "type": "array"
          }
        },
        "title": "ModuleListResponse",
        "type": "object"
      },
      "ProbeResult": {
        "description": "Validated ffprobe output, reduced to the metadata we retain.",
        "properties": {
          "artist": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artist"
          },
          "audio_streams": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/AudioStreamInfo"
            },
            "maxItems": 64,
            "title": "Audio Streams",
            "type": "array"
          },
          "byte_count": {
            "minimum": 0.0,
            "title": "Byte Count",
            "type": "integer"
          },
          "estimated_duration_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Duration Seconds"
          },
          "ffmpeg_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ffmpeg Version",
            "type": "string"
          },
          "ffprobe_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ffprobe Version",
            "type": "string"
          },
          "format_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Format Name",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "format_name",
          "byte_count",
          "ffmpeg_version",
          "ffprobe_version"
        ],
        "title": "ProbeResult",
        "type": "object"
      },
      "ProjectListResponse": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectRecord"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "ProjectListResponse",
        "type": "object"
      },
      "ProjectRecord": {
        "description": "A persisted working project.\n\nAn empty project has ``status == \"empty\"`` and all source fields\nnull. A ready project has the original-file asset, the canonical\nPCM asset, and complete source timing/channel metadata.",
        "properties": {
          "canonical_asset_id": {
            "anyOf": [
              {
                "description": "UUID identifier, serialized as a string",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Asset Id"
          },
          "created_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Created At",
            "type": "string"
          },
          "decode_profile_version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decode Profile Version"
          },
          "duration_frames": {
            "anyOf": [
              {
                "description": "Integer source sample position (never milliseconds)",
                "maximum": 9007199254740991.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Decoded frame count of the canonical audio (authoritative)",
            "title": "Duration Frames"
          },
          "id": {
            "description": "UUID identifier, serialized as a string",
            "title": "Id",
            "type": "string"
          },
          "monitoring_asset_id": {
            "anyOf": [
              {
                "description": "UUID identifier, serialized as a string",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monitoring Asset Id"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "default": 0,
            "description": "Nonnegative integer revision",
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "sample_rate": {
            "anyOf": [
              {
                "description": "Sample rate in Hz",
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected source stream sample rate in Hz",
            "title": "Sample Rate"
          },
          "schema_version": {
            "default": 2,
            "description": "Project schema version",
            "minimum": 1.0,
            "title": "Schema Version",
            "type": "integer"
          },
          "source_asset_id": {
            "anyOf": [
              {
                "description": "UUID identifier, serialized as a string",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Asset Id"
          },
          "source_channel_count": {
            "anyOf": [
              {
                "maximum": 8.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Channel Count"
          },
          "source_channel_layout": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Channel Layout"
          },
          "source_metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Source metadata summary (format, title, artist, ...)",
            "title": "Source Metadata",
            "type": "object"
          },
          "source_stream_index": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Stream Index"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus",
            "default": "empty"
          },
          "updated_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Updated At",
            "type": "string"
          },
          "waveform_status": {
            "$ref": "#/components/schemas/WaveformStatus",
            "default": "none"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectRecord",
        "type": "object"
      },
      "ProjectStatus": {
        "enum": [
          "empty",
          "ready"
        ],
        "title": "ProjectStatus",
        "type": "string"
      },
      "SelectStreamRequest": {
        "properties": {
          "stream_index": {
            "minimum": 0.0,
            "title": "Stream Index",
            "type": "integer"
          }
        },
        "required": [
          "stream_index"
        ],
        "title": "SelectStreamRequest",
        "type": "object"
      },
      "SystemResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "app_version",
          "api_version",
          "ready"
        ],
        "title": "SystemResponse",
        "type": "object"
      },
      "TransferState": {
        "enum": [
          "created",
          "uploading",
          "complete",
          "cancelled",
          "failed"
        ],
        "title": "TransferState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WaveformStatus": {
        "enum": [
          "none",
          "pending",
          "ready"
        ],
        "title": "WaveformStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "basseparate",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/imports": {
      "post": {
        "operationId": "create_import_api_v1_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Import"
      }
    },
    "/api/v1/imports/{import_id}": {
      "get": {
        "operationId": "get_import_api_v1_imports__import_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "import_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Import Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Import"
      }
    },
    "/api/v1/imports/{import_id}/cancel": {
      "post": {
        "operationId": "cancel_import_api_v1_imports__import_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "import_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Import Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Import"
      }
    },
    "/api/v1/imports/{import_id}/chunks": {
      "put": {
        "operationId": "upload_chunk_api_v1_imports__import_id__chunks_put",
        "parameters": [
          {
            "in": "path",
            "name": "import_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Import Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": true,
            "schema": {
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChunkAckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Chunk"
      }
    },
    "/api/v1/imports/{import_id}/complete": {
      "post": {
        "operationId": "complete_import_api_v1_imports__import_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "import_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Import Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Import"
