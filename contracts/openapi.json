{
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelListResponse": {
        "properties": {
          "models": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "title": "ModelListResponse",
        "type": "object"
      },
      "ModuleListResponse": {
        "properties": {
          "modules": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Modules",
            "type": "array"
          }
        },
        "title": "ModuleListResponse",
        "type": "object"
      },
      "ProjectListResponse": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectRecord"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "ProjectListResponse",
        "type": "object"
      },
      "ProjectRecord": {
        "description": "A persisted working project.\n\nAn empty project has ``status == \"empty\"``, ``source_asset_id`` is null,\nand both source timing fields are null.",
        "properties": {
          "created_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Created At",
            "type": "string"
          },
          "duration_samples": {
            "anyOf": [
              {
                "description": "Integer source sample position (never milliseconds)",
                "maximum": 9007199254740991.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Samples"
          },
          "id": {
            "description": "UUID identifier, serialized as a string",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "default": 0,
            "description": "Nonnegative integer revision",
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "sample_rate": {
            "anyOf": [
              {
                "description": "Sample rate in Hz",
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Rate"
          },
          "schema_version": {
            "default": 1,
            "description": "Project schema version",
            "minimum": 1.0,
            "title": "Schema Version",
            "type": "integer"
          },
          "source_asset_id": {
            "anyOf": [
              {
                "description": "UUID identifier, serialized as a string",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Asset Id"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus",
            "default": "empty"
          },
          "updated_at": {
            "description": "UTC timestamp in ISO 8601 form",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectRecord",
        "type": "object"
      },
      "ProjectStatus": {
        "enum": [
          "empty",
          "ready"
        ],
        "title": "ProjectStatus",
        "type": "string"
      },
      "SystemResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "app_version",
          "api_version",
          "ready"
        ],
        "title": "SystemResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "basseparate",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models"
      }
    },
    "/api/v1/modules": {
      "get": {
        "operationId": "list_modules_api_v1_modules_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Modules"
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "list_projects_api_v1_projects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Projects"
      },
      "post": {
        "operationId": "create_project_api_v1_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Project"
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "operationId": "get_project_api_v1_projects__project_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Project"
      }
    },
    "/api/v1/system": {
      "get": {
        "operationId": "system_api_v1_system_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "System"
      }
    }
  }
}
