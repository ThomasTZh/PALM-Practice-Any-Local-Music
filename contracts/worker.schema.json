        "job_id",
        "stage"
      ],
      "title": "ProgressPayload",
      "type": "object"
    },
    "RunPayload": {
      "description": "Request to execute one media job (backend \u2192 worker).",
      "properties": {
        "job_id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "job_type": {
          "$ref": "#/$defs/JobType"
        },
        "max_threads": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Threads",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "staging_dir": {
          "minLength": 1,
          "title": "Staging Dir",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "job_type",
        "source_path",
        "staging_dir"
      ],
      "title": "RunPayload",
      "type": "object"
    },
    "ShutdownPayload": {
      "properties": {},
      "title": "ShutdownPayload",
      "type": "object"
    },
    "StoppedPayload": {
