    "ProgressPayload": {
      "description": "A progress report for a running job (worker \u2192 backend).",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction"
        },
        "job_id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "stage": {
