{
  "$defs": {
    "CancelPayload": {
      "description": "Request to cancel a running job (backend \u2192 worker).",
      "properties": {
        "job_id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "CancelPayload",
      "type": "object"
    },
    "CancelledPayload": {
      "description": "Confirmation that a job was cancelled (worker \u2192 backend).",
      "properties": {
        "job_id": {
          "description": "UUID identifier, serialized as a string",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "staging_removed": {
          "title": "Staging Removed",
          "type": "boolean"
        }
      },
      "required": [
        "job_id",
        "staging_removed"
      ],
      "title": "CancelledPayload",
      "type": "object"
    },
    "CapabilitiesPayload": {
