    "JobStage": {
      "description": "Progress stages reported by workers (milestone1.md \u00a76.6).",
      "enum": [
        "transferring",
        "verifying",
        "inspecting",
        "decoding",
        "preparing_playback",
        "preparing_input",
        "separating",
        "loading_model",
        "running_inference",
        "writing_activations",
        "validating_artifact",
        "decoding_pulses",
        "building_waveform",
        "verifying_stems",
        "encoding",
        "verifying_export",
        "ready"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "JobType": {
      "enum": [
